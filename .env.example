# ============================================================
# ENVIRONMENT VARIABLES FOR DIAMANTE AUTO TRANSFER BOT
# ============================================================
# Usage:
#   LOCAL DEVELOPMENT: Copy to .env file
#   REPLIT: Add to Secrets tab (gear icon in sidebar)
#   YOUR SERVER: Copy to .env file on your server
# ============================================================

# ============================================================
# REQUIRED - Telegram Bot
# ============================================================
# Get from @BotFather on Telegram (required for bot to run)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# ============================================================
# OPTIONAL - Admin Access
# ============================================================
# Your Telegram user ID for admin commands (optional)
# Get by sending /start to @userinfobot on Telegram
ADMIN_ID=your_telegram_user_id

# ============================================================
# OPTIONAL - API Credentials
# ============================================================
# These can be obtained from Diamante API dashboard
# If not provided, will use stored token from tokens.json file
ACCESS_TOKEN=your_diamante_access_token
USER_ID=your_diamante_user_id

# ============================================================
# OPTIONAL - Wallet Authentication
# ============================================================
# Private key for wallet authentication (optional)
# If set, bot will attempt to generate fresh token on startup
# Format: Include 0x prefix (e.g., 0x1234...)
# SECURITY: Never commit this to version control!
# WALLET_PRIVATE_KEY=0xyour_wallet_private_key_with_0x_prefix
